FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN useradd -m -u 10001 ultron && mkdir -p /app/data && chown -R ultron:ultron /app

COPY requirements-trainer.txt /app/requirements-trainer.txt
RUN pip install --no-cache-dir -r /app/requirements-trainer.txt

COPY ultronpro /app/ultronpro

USER ultron
EXPOSE 8025

CMD ["uvicorn", "ultronpro.inference_api:app", "--host", "0.0.0.0", "--port", "8025"]
